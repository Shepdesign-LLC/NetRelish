// Config.xcconfig — optional. Copy this file to Config.xcconfig at the repo root to override
// the endpoints committed in Config/Base.xcconfig on your own Mac. Config.xcconfig is gitignored.
//
// CLAUDE.md non-negotiable 5: these are the ONLY endpoints the app may talk to besides page
// loads and StoreKit. Adding one is adding one to that list. In an xcconfig `//` starts a
// comment, so write `http:/$()/host`.

// RFC 3161 timestamping authority for Pro provenance.
// NR_TIMESTAMP_URL = http:/$()/timestamp.example.com

// One-time license activation for the Direct build only. Unused by the App Store build.
// NR_LICENSE_ACTIVATION_URL = https:/$()/license.example.com/activate

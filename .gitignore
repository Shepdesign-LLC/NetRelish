# Swift package / Xcode build output
.build/
.swiftpm/
# Root lockfile from PantryKit (Package.swift) resolution — the workspace Package.resolved
# inside NetRelish.xcodeproj stays committed; two lockfiles would drift (ADR 0009).
/Package.resolved
DerivedData/
*.xcuserstate
xcuserdata/

# secrets — NEVER commit these (CLAUDE.md: endpoints come from Config.xcconfig)
Config.xcconfig
.env
.env.*
*.p12
*.cer
*.certSigningRequest
*.provisionprofile
AuthKey_*.p8
*.key

# macOS
.DS_Store
*.dmg
*.app

# editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# logs
*.log

# Python bytecode from scripts/ and its tests
__pycache__/
*.pyc

# Zest one-origin deploy output (zest/build.sh)
zest/dist/

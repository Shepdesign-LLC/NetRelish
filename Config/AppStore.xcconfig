// AppStore.xcconfig — the Mac App Store build. StoreKit 2 for billing.
#include "Base.xcconfig"
NR_DISTRIBUTION = appstore

// The App Store build never asks for a license key (App Review 2.4.5), so it carries no
// license address either: its Info.plist says nothing about a relay (ADR 0032). This comes
// after Base and a local Config.xcconfig, so neither can put one back.
NR_LICENSE_ACTIVATION_URL =

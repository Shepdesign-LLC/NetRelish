# Copy to .env.local — never commit the real values.
# Signing / notarization are supplied by CI secrets in release builds.

APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
APPLE_ID="you@example.com"
APPLE_PASSWORD="app-specific-password"
APPLE_TEAM_ID="TEAMID"

# Tauri updater signing (generate with: npm run tauri signer generate)
TAURI_SIGNING_PRIVATE_KEY=""
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# Supabase (P4 sync). The anon/publishable key is safe to ship in the client —
# RLS is what protects the data, not the key. Copy to apps/desktop/.env.local
VITE_SUPABASE_URL="https://qiyqlbaggqthcuxslwyk.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

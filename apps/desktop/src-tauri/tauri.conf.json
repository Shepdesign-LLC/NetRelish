{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetRelish",
  "version": "0.2.1",
  "identifier": "com.netrelish.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "NetRelish",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.netrelish.com https://*.supabase.co wss://*.supabase.co; frame-src https:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "copyright": "\u00a9 NetRelish. Code MIT. Brand all rights reserved.",
    "shortDescription": "The browser for people who build the web",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 180
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "resources": [
      "models/*"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:netrelish.db"
      ]
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/Shepdesign-LLC/NetRelish/releases/latest/download/latest.json",
        "https://netrelish.com/releases/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMEVGRDUwQkM5RUEyRjQKUldUMG9wNjhVUDBPUGZHQitXK0c3KzZTZ3RHdDdoRSttY0ZEKzRFWnJDaENFa2NtZ0JsTEVQTFYK"
    }
  }
}